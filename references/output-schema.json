{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agy-video-reader/output-schema.json",
  "title": "Agy video reader result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "source",
    "summary",
    "visual_summary",
    "audio_summary",
    "timeline",
    "uncertainties",
    "evidence_quality"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "cli_version",
        "model",
        "attachment_confirmed",
        "attachment_mime"
      ],
      "properties": {
        "provider": {
          "const": "antigravity-cli"
        },
        "cli_version": {
          "const": "1.1.1"
        },
        "model": {
          "const": "Gemini 3.5 Flash (High)"
        },
        "attachment_confirmed": {
          "const": true
        },
        "attachment_mime": {
          "type": "string",
          "enum": [
            "video/mp4",
            "video/quicktime",
            "video/webm",
            "video/x-msvideo",
            "video/avi",
            "video/msvideo"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "visual_summary": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "audio_summary": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineItem"
      }
    },
    "uncertainties": {
      "$ref": "#/$defs/textList"
    },
    "evidence_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual",
        "audio",
        "temporal"
      ],
      "properties": {
        "visual": {
          "$ref": "#/$defs/quality"
        },
        "audio": {
          "$ref": "#/$defs/quality"
        },
        "temporal": {
          "$ref": "#/$defs/quality"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "textList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-5]\\d:[0-5]\\d|\\d{1,3}:[0-5]\\d:[0-5]\\d)(?:\\.\\d{1,3})?$"
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "visual_event",
        "audio_event",
        "on_screen_text",
        "confidence",
        "uncertainties"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "visual_event": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "audio_event": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "on_screen_text": {
          "$ref": "#/$defs/textList"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainties": {
          "$ref": "#/$defs/textList"
        }
      }
    },
    "quality": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    }
  }
}
